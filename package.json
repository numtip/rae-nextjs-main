{
  "name": "rae-nextjs-main",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run kpi:validate",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "kpi:validate": "tsx scripts/validate-kpi-snapshot.ts",
    "smoke:test": "tsx src/__tests__/smoke.ts",
    "test": "tsx src/__tests__/smoke.ts && tsx __tests__/budget-stats.test.ts && tsx __tests__/rdc-budget-normalizer.test.ts && tsx __tests__/rdc-snapshot-export.test.ts && tsx __tests__/rdc-fallback.test.ts && tsx src/__tests__/full-dataset-validation.ts && tsx __tests__/data-quality-audit.ts && tsx __tests__/portfolio-stats.test.ts",
    "rdc:export": "tsx scripts/export-rdc-budget.ts",
    "rdc:validate": "tsx scripts/validate-rdc-budget-snapshot.ts",
    "rdc:sync": "npm run rdc:export && npm run rdc:validate"
  },
  "dependencies": {
    "mssql": "^12.5.5",
    "next": "16.2.4",
    "papaparse": "^5.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@types/mssql": "^12.3.0",
    "@types/node": "20.19.39",
    "@types/papaparse": "^5.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.2.4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
